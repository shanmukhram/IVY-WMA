<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IVY Windows app shell (PRD Part 1 "App UI", WP1-WP3, WU5; PLAN task 1.8). WinUI 3 on the Windows App SDK 1.6,
    unpackaged and self-contained (no MSIX, no separate runtime install). Builds on Windows only, so it is in
    windows/Ivy.Windows.sln and NOT in windows/Ivy.sln. All logic it can avoid owning lives in Ivy.App.Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Ivy.App</RootNamespace>
    <AssemblyName>Ivy.App</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ivy.ico</ApplicationIcon>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- Program.cs owns Main: single-instance redirection must run before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- XAML-generated code is outside our control; keep warnings visible but not fatal for this project only. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ivy.App.Core\Ivy.App.Core.csproj" />
    <ProjectReference Include="..\Ivy.Collectors\Ivy.Collectors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ivy.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
