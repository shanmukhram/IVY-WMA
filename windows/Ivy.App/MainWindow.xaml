<?xml version="1.0" encoding="utf-8"?>
<!--
    Fourth run (Fluent redesign): one window on Mica with a custom title bar. Until the PC is paired it shows only the
    pairing page (a centred card); after that, a NavigationView in left-pane mode:

        Overview
        Collectors      (group: Files, Screenshots, App usage, Notifications)
        Conversations   (group: Telegram, LINE; brand marks set in code-behind from the simple-icons resource)
        Transfers
        Settings
        ............
        Activity        (footer)

    Every NavigationViewItem.Tag is a NavPages constant (Ivy.App.Core/ViewModels/NavigationViewModel.cs); group items
    only expand and collapse (SelectsOnInvoked="False"). The selected page and the expanded groups live in
    ViewModel.Navigation (persisted); MainWindow.xaml.cs keeps the NavigationView and the Frame in step with it.
-->
<Window
    x:Class="Ivy.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ivy.App"
    Title="IVY">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar (drag region; caption buttons are drawn by the system on the right) ============ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="12" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarIcon" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="IVY" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Windows companion" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- ============ Not paired: a centred card, shown until pairing completes ============ -->
        <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.ShowPairing, Mode=OneWay}">
            <Border Style="{StaticResource CardStyle}" MaxWidth="560" Padding="32" Margin="16,32,16,48"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource GlyphTileStyle}" Width="48" Height="48" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE71B;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pair with your Mac" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Enter the pairing code here." />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBox x:Name="PairingBox"
                                 Header="Pairing string"
                                 PlaceholderText="IVYPAIR1...."
                                 Text="{x:Bind ViewModel.Pairing.PairingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.Pairing.CanEdit, Mode=OneWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="104"
                                 FontFamily="{StaticResource IvyMono}"
                                 AutomationProperties.Name="Pairing string" />
                        <!-- Inline error with a fix hint (no dialog). -->
                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Pairing.HasError, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA39;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Pairing.ErrorText, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Pairing.ErrorHint, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Pair" Style="{StaticResource AccentButtonStyle}" MinWidth="96" AccessKey="P"
                                Command="{x:Bind ViewModel.Pairing.PairCommand}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Pairing.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                      AutomationProperties.Name="Pairing in progress" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Pairing.Status, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               IsTextSelectionEnabled="True"
                               Visibility="{x:Bind local:Ui.CollapsedWhen(ViewModel.Pairing.HasError), Mode=OneWay}" />

                    <!-- After pairing: both fingerprints, to compare with the Mac's screen. -->
                    <Border Visibility="{x:Bind ViewModel.Pairing.HasFingerprints, Mode=OneWay}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="16">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="This PC" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Pairing.DeviceFingerprint, Mode=OneWay}"
                                       Style="{StaticResource MonoValueStyle}" FontSize="18" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mac" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Pairing.MacFingerprint, Mode=OneWay}"
                                       Style="{StaticResource MonoValueStyle}" FontSize="18" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}"
                                       Text="Both must match what the Mac shows. If they differ, do not continue: revoke this device on the Mac and start again." />
                        </Grid>
                    </Border>
                    <Button Content="Continue" Style="{StaticResource AccentButtonStyle}" MinWidth="96" AccessKey="C"
                            Command="{x:Bind ViewModel.Pairing.ContinueCommand}"
                            Visibility="{x:Bind ViewModel.Pairing.Completed, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============ Paired: navigation shell ============ -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        Visibility="{x:Bind local:Ui.VisibleWhenEither(ViewModel.ShowMain, ViewModel.ShowLocked), Mode=OneWay}"
                        PaneDisplayMode="Left"
                        OpenPaneLength="264"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        Loaded="NavView_Loaded"
                        PaneOpened="NavView_PaneOpened"
                        SelectionChanged="NavView_SelectionChanged"
                        Expanding="NavView_Expanding"
                        Collapsed="NavView_Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" AccessKey="O" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CollectorsGroupItem" Content="Collectors" Tag="collectors" SelectsOnInvoked="False" AccessKey="L" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Files" Tag="files">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Screenshots" Tag="screenshots">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE722;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="App usage" Tag="usage">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9D2;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Notifications" Tag="notifications">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEA8F;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConversationsGroupItem" Content="Conversations" Tag="conversations" SelectsOnInvoked="False" AccessKey="V" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <!-- Icons: brand marks (PathIcon) or the initials tile, set in MainWindow.xaml.cs. -->
                        <NavigationViewItem x:Name="TelegramNavItem" Content="Telegram" Tag="telegram" />
                        <NavigationViewItem x:Name="LineNavItem" Content="LINE" Tag="line" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="Transfers" Tag="transfers" AccessKey="T" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings" AccessKey="S" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Activity" Tag="activity" AccessKey="A" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Bottom of the pane. Unlocked: run state, one line. Locked: a plain "IVY" button that fits the 48 px compact rail
                 (PaneFooter is rendered in compact mode); each press counts toward the unlock gesture. -->
            <NavigationView.PaneFooter>
                <StackPanel>
                    <TextBlock Margin="16,4,16,12" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}"><Run Text="{x:Bind ViewModel.RunStateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.PendingObjectsText, Mode=OneWay}" /><Run Text=" queued" /></TextBlock>
                    <Button x:Name="LockButton" Width="48" Margin="0,4,0,8" Padding="0" BorderThickness="0"
                            Background="Transparent" HorizontalAlignment="Center"
                            AutomationProperties.Name="IVY"
                            Visibility="{x:Bind ViewModel.ShowLocked, Mode=OneWay}"
                            Click="LockButton_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="IVY" HorizontalAlignment="Center" />
                            <TextBlock Text="&#x2026;" Opacity="0.5" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.Lock.ShowHint, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" CacheSize="12" />
        </NavigationView>
    </Grid>
</Window>
