<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ivy.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ivy.App"
    xmlns:core="using:Ivy.App.Core"
    xmlns:vm="using:Ivy.App.Core.ViewModels"
    Title="IVY">

    <Grid x:Name="Root" Background="{StaticResource IvyBackground}">

        <!-- ============ Not paired: paste the pairing string, Pair, compare fingerprints ============ -->
        <ScrollViewer Visibility="{x:Bind ViewModel.ShowPairing, Mode=OneWay}">
            <StackPanel Margin="32" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="IVY: pair this PC" FontSize="20" Foreground="{StaticResource IvyText}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource IvyMuted}"
                           Text="On the Mac, add a Windows device and copy the pairing string. Paste it here. This is the only thing ever typed on Windows." />
                <TextBox x:Name="PairingBox"
                         Header="Pairing string"
                         PlaceholderText="IVYPAIR1...."
                         Text="{x:Bind ViewModel.Pairing.PairingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.Pairing.CanEdit, Mode=OneWay}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                         FontFamily="{StaticResource IvyMono}"
                         BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Pair" Command="{x:Bind ViewModel.Pairing.PairCommand}" />
                    <Button Content="Continue" Command="{x:Bind ViewModel.Pairing.ContinueCommand}"
                            Visibility="{x:Bind ViewModel.Pairing.Completed, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.Pairing.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Pairing.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{StaticResource IvyText}" />
                <Border Visibility="{x:Bind ViewModel.Pairing.HasFingerprints, Mode=OneWay}"
                        BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="This device" Foreground="{StaticResource IvyMuted}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Pairing.DeviceFingerprint, Mode=OneWay}"
                                   FontFamily="{StaticResource IvyMono}" FontSize="16" IsTextSelectionEnabled="True" Foreground="{StaticResource IvyAccent}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mac" Foreground="{StaticResource IvyMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Pairing.MacFingerprint, Mode=OneWay}"
                                   FontFamily="{StaticResource IvyMono}" FontSize="16" IsTextSelectionEnabled="True" Foreground="{StaticResource IvyAccent}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{StaticResource IvyMuted}"
                                   Text="Both must match what the Mac shows. If they differ, do not continue: unpair on the Mac and start again." />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Paired: status window ============ -->
        <Grid Visibility="{x:Bind ViewModel.ShowMain, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: global Paused/Running -->
            <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="16" BorderBrush="{StaticResource IvyBorder}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IVY" FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource IvyText}" />
                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsRunning, Mode=TwoWay}" OnContent="Running" OffContent="Paused"
                              VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.HostErrorText, Mode=OneWay}" Foreground="{StaticResource IvyError}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.Settings.SettingsError, Mode=OneWay}" Foreground="{StaticResource IvyError}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Grid>

            <!-- Body: status and settings on the left, live activity feed on the right -->
            <Grid Grid.Row="1" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="560" />
                    <ColumnDefinition Width="2*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Padding="16,12" BorderBrush="{StaticResource IvyBorder}" BorderThickness="0,0,1,0">
                    <StackPanel Spacing="12" Margin="0,0,16,16">

                        <!-- Collectors -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Collectors" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Collector" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Column="2" Text="On" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Column="3" Text="Last capture" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Column="4" Text="Last upload" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Column="5" Text="Queue" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Column="6" Text="Status" Foreground="{StaticResource IvyMuted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Collectors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CollectorRowViewModel">
                                            <Grid ColumnSpacing="8" Padding="0,2" BorderBrush="{StaticResource IvyBorder}" BorderThickness="0,1,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{x:Bind local:Ui.Brush(StatusColor), Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="on" OffContent="off"
                                                              MinWidth="0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind LastCaptureText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind LastUploadText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind QueueDepthText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Conversation capture: Telegram (WT) and LINE (WL) -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Conversation capture" FontWeight="SemiBold" />

                                <TextBlock Text="Telegram" Foreground="{StaticResource IvyMuted}" />
                                <TextBlock Text="{x:Bind ViewModel.Conversation.TelegramStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource IvyMono}" />
                                <ToggleSwitch Header="Include channels (groups and DMs are always captured)"
                                              IsOn="{x:Bind ViewModel.Conversation.IncludeChannels, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{x:Bind ViewModel.Conversation.TelegramNeedsPasscode, Mode=OneWay}">
                                    <PasswordBox x:Name="TelegramPasscodeBox" Width="220"
                                                 Header="Telegram Desktop local passcode"
                                                 PasswordChanged="TelegramPasscode_Changed"
                                                 BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <Button Content="Apply" VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.Conversation.ApplyPasscodeCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Conversation.PasscodeStatusText, Mode=OneWay}"
                                           FontFamily="{StaticResource IvyMono}" TextWrapping="Wrap" />

                                <TextBlock Text="LINE" Foreground="{StaticResource IvyMuted}" Margin="0,8,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.Conversation.LineStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource IvyMono}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Run probe" Command="{x:Bind ViewModel.Conversation.RunProbeCommand}" />
                                    <Button Content="Open report" Command="{x:Bind ViewModel.Conversation.OpenReportCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Conversation.ReportPathText, Mode=OneWay}"
                                           FontFamily="{StaticResource IvyMono}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Border>

                        <!-- Initial file index -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Initial file index" FontWeight="SemiBold" />
                                <ProgressBar Value="{x:Bind ViewModel.ImportPercent, Mode=OneWay}" Minimum="0" Maximum="100" />
                                <TextBlock Text="{x:Bind ViewModel.ImportText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ImportBytesText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" />
                            </StackPanel>
                        </Border>

                        <!-- Upload queue -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Upload queue" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Pending objects" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PendingObjectsText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" />
                                    <TextBlock Grid.Row="1" Text="Pending bytes" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PendingBytesText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" />
                                    <TextBlock Grid.Row="2" Text="Retrying" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.RetryingText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" />
                                    <TextBlock Grid.Row="3" Text="Current upload" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CurrentUploadText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ProgressBar Value="{x:Bind ViewModel.CurrentUploadPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                             Visibility="{x:Bind ViewModel.HasCurrentUpload, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Header="Bandwidth cap (KB/s, 0 = unlimited)" Width="240"
                                             Text="{x:Bind ViewModel.Settings.BandwidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource IvyMono}" BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <Button Content="Apply" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Settings.ApplyBandwidthCommand}" />
                                    <TextBlock Text="{x:Bind ViewModel.Settings.BandwidthStatus, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                               FontFamily="{StaticResource IvyMono}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Sync now" Command="{x:Bind ViewModel.SyncNowCommand}" />
                                    <TextBlock Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource IvyMono}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Indexed folders -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Indexed folders and drives" FontWeight="SemiBold" />
                                <ListView x:Name="IndexedRootsList" ItemsSource="{x:Bind ViewModel.Settings.IndexedRoots.Items}" SelectionMode="Single"
                                          MinHeight="40" MaxHeight="160" FontFamily="{StaticResource IvyMono}"
                                          BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Add folder..." Click="AddIndexedRoot_Click" />
                                    <Button Content="Remove selected" Click="RemoveIndexedRoot_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Originals uploaded automatically (PLAN decision 8 media policy) -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Originals uploaded from indexed folders" FontWeight="SemiBold" />
                                <TextBlock Text="Images go to the Mac for OCR, documents for text search. Other files: metadata and thumbnail, original on request."
                                           Foreground="{StaticResource IvyMuted}" TextWrapping="Wrap" />
                                <ToggleSwitch Header="Upload images" IsOn="{x:Bind ViewModel.Settings.AutoUploadImages, Mode=TwoWay}" />
                                <ToggleSwitch Header="Upload documents" IsOn="{x:Bind ViewModel.Settings.AutoUploadDocuments, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Header="Image cap (MB)" Width="140"
                                             Text="{x:Bind ViewModel.Settings.ImageCapText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource IvyMono}" BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <TextBox Header="Document cap (MB)" Width="140"
                                             Text="{x:Bind ViewModel.Settings.DocumentCapText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource IvyMono}" BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <Button Content="Apply" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Settings.ApplyCapsCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Settings.CapsStatus, Mode=OneWay}" FontFamily="{StaticResource IvyMono}" TextWrapping="Wrap" />
                                <TextBlock Text="Image extensions:" Foreground="{StaticResource IvyMuted}" />
                                <ListView x:Name="ImageExtensionsList" ItemsSource="{x:Bind ViewModel.Settings.ImageExtensions.Items}" SelectionMode="Single"
                                          MinHeight="40" MaxHeight="120" FontFamily="{StaticResource IvyMono}"
                                          BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="160" PlaceholderText="e.g. tif"
                                             Text="{x:Bind ViewModel.Settings.ImageExtensions.NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource IvyMono}" BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <Button Content="Add" Click="AddImageExtension_Click" />
                                    <Button Content="Remove selected" Click="RemoveImageExtension_Click" />
                                </StackPanel>
                                <TextBlock Text="Document extensions:" Foreground="{StaticResource IvyMuted}" />
                                <ListView x:Name="DocumentExtensionsList" ItemsSource="{x:Bind ViewModel.Settings.DocumentExtensions.Items}" SelectionMode="Single"
                                          MinHeight="40" MaxHeight="120" FontFamily="{StaticResource IvyMono}"
                                          BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="160" PlaceholderText="e.g. odt"
                                             Text="{x:Bind ViewModel.Settings.DocumentExtensions.NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource IvyMono}" BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <Button Content="Add" Click="AddDocumentExtension_Click" />
                                    <Button Content="Remove selected" Click="RemoveDocumentExtension_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Screenshot folders -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Screenshot folders" FontWeight="SemiBold" />
                                <ListView x:Name="ScreenshotRootsList" ItemsSource="{x:Bind ViewModel.Settings.ScreenshotRoots.Items}" SelectionMode="Single"
                                          MinHeight="40" MaxHeight="120" FontFamily="{StaticResource IvyMono}"
                                          BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Add folder..." Click="AddScreenshotRoot_Click" />
                                    <Button Content="Remove selected" Click="RemoveScreenshotRoot_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Window titles -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="App usage: window titles" FontWeight="SemiBold" />
                                <ToggleSwitch Header="Capture window titles" IsOn="{x:Bind ViewModel.Settings.WindowTitleCapture, Mode=TwoWay}" />
                                <TextBlock Text="Never capture titles for (executable name or title text):" Foreground="{StaticResource IvyMuted}" />
                                <ListView x:Name="ExclusionsList" ItemsSource="{x:Bind ViewModel.Settings.TitleExclusions.Items}" SelectionMode="Single"
                                          MinHeight="40" MaxHeight="160" FontFamily="{StaticResource IvyMono}"
                                          BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="260" PlaceholderText="e.g. keepass.exe"
                                             Text="{x:Bind ViewModel.Settings.TitleExclusions.NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource IvyMono}" BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" />
                                    <Button Content="Add" Click="AddExclusion_Click" />
                                    <Button Content="Remove selected" Click="RemoveExclusion_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Startup -->
                        <Border BorderBrush="{StaticResource IvyBorder}" BorderThickness="1" Background="{StaticResource IvyPanel}" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Startup" FontWeight="SemiBold" />
                                <ToggleSwitch Header="Run at login (starts in the tray)" IsOn="{x:Bind ViewModel.Settings.RunAtLogin, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Live activity feed -->
                <Grid Grid.Column="1" Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Activity" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox x:Name="PauseScrollBox" Content="Pause scroll" Checked="PauseScroll_Changed" Unchecked="PauseScroll_Changed" />
                        <TextBlock Text="{x:Bind ViewModel.Feed.HeldText, Mode=OneWay}" Foreground="{StaticResource IvyMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Feed.Items}" SelectionMode="None" Margin="0,8,0,0"
                              BorderBrush="{StaticResource IvyBorder}" BorderThickness="1">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="22" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:FeedEntry">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" FontFamily="{StaticResource IvyMono}" Foreground="{StaticResource IvyMuted}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CollectorText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Event}" Foreground="{StaticResource IvyAccent}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DetailText}" FontFamily="{StaticResource IvyMono}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Footer: bucket reachability, pairing fingerprint, version -->
            <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="24" RowSpacing="2" BorderBrush="{StaticResource IvyBorder}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ViewModel.UpBucketText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}"
                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.CmdBucketText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}"
                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FingerprintText, Mode=OneWay}" FontFamily="{StaticResource IvyMono}"
                           IsTextSelectionEnabled="True" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.VersionText}" Foreground="{StaticResource IvyMuted}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
