<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ivy.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The whole palette: near-black background, 1px borders, one green accent (PRD "App UI"). -->
            <Color x:Key="IvyAccentColor">#3ECF8E</Color>
            <SolidColorBrush x:Key="IvyBackground" Color="#111111" />
            <SolidColorBrush x:Key="IvyPanel" Color="#171717" />
            <SolidColorBrush x:Key="IvyBorder" Color="#2E2E2E" />
            <SolidColorBrush x:Key="IvyText" Color="#EDEDED" />
            <SolidColorBrush x:Key="IvyMuted" Color="#8F8F8F" />
            <SolidColorBrush x:Key="IvyAccent" Color="#3ECF8E" />
            <SolidColorBrush x:Key="IvyError" Color="#E5484D" />
            <FontFamily x:Key="IvyMono">Consolas</FontFamily>

            <!-- Make system accent-coloured controls (toggles, buttons, progress) use the same green. -->
            <Color x:Key="SystemAccentColor">#3ECF8E</Color>
            <Color x:Key="SystemAccentColorLight1">#3ECF8E</Color>
            <Color x:Key="SystemAccentColorLight2">#3ECF8E</Color>
            <Color x:Key="SystemAccentColorLight3">#3ECF8E</Color>
            <Color x:Key="SystemAccentColorDark1">#2EA572</Color>
            <Color x:Key="SystemAccentColorDark2">#2EA572</Color>
            <Color x:Key="SystemAccentColorDark3">#2EA572</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
