<?xml version="1.0" encoding="utf-8"?>
<!-- Activity (footer item): the full live feed, newest first, bounded to 500 lines, with pause-scroll. -->
<Page
    x:Class="Ivy.App.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Ivy.App.Core"
    NavigationCacheMode="Required">

    <Grid Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Activity" Style="{StaticResource PageTitleStyle}" />
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                       Text="Every capture, encryption and upload as it happens: object keys, sizes and outcomes, never content. Last 500 lines." />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Feed.HeldText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="2" Click="PauseScroll_Click" AccessKey="P"
                          IsChecked="{x:Bind ViewModel.Feed.ScrollPaused, Mode=OneWay}"
                          AutomationProperties.Name="Pause scroll">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE769;" FontSize="12" />
                    <TextBlock Text="Pause scroll" />
                </StackPanel>
            </ToggleButton>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
            <ListView ItemsSource="{x:Bind ViewModel.Feed.Items}" SelectionMode="None"
                      AutomationProperties.Name="Live activity, newest first">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:FeedEntry">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" FontFamily="{StaticResource IvyMono}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind CollectorText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Event}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DetailText}" FontFamily="{StaticResource IvyMono}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
