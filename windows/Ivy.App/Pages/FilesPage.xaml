<?xml version="1.0" encoding="utf-8"?>
<!-- Files collector: status card with its toggle, initial index, indexed roots, exclusions and the media policy. -->
<Page
    x:Class="Ivy.App.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ivy.App"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Spacing="8">
            <Grid ColumnSpacing="16" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlyphTileStyle}" Width="48" Height="48">
                    <FontIcon Glyph="&#xE8B7;" FontSize="22" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Files" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FilesRow.Description}" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                </StackPanel>
            </Grid>

            <InfoBar IsClosable="False"
                     IsOpen="{x:Bind ViewModel.FilesRow.HasProblem, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.FilesRow.HasProblem, Mode=OneWay}"
                     Severity="{x:Bind local:Ui.Severity(ViewModel.FilesRow.Severity), Mode=OneWay}"
                     Title="{x:Bind ViewModel.FilesRow.ProblemTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.FilesRow.StatusReason, Mode=OneWay}" />
            <InfoBar IsClosable="False" Severity="Error" Title="Settings"
                     IsOpen="{x:Bind local:Ui.HasText(ViewModel.Settings.SettingsError), Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Settings.SettingsError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.Settings.SettingsError, Mode=OneWay}" />

            <!-- ============ Status (toggle in the header) ============ -->
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind local:Ui.Brush(ViewModel.FilesRow.StatusColor), Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FilesRow.StatusLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" AccessKey="N"
                                      IsOn="{x:Bind ViewModel.FilesRow.Enabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Files collector" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FilesRow.StatusReason, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Last capture" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FilesRow.LastCaptureText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Last upload" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.FilesRow.LastUploadText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="3" Text="Queue" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.FilesRow.QueueContributionText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ Initial index ============ -->
            <TextBlock Text="Initial index" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <ProgressBar Value="{x:Bind ViewModel.ImportPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                 AutomationProperties.Name="Initial index progress" />
                    <TextBlock Text="{x:Bind ViewModel.ImportText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ImportBytesText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ============ Indexed folders ============ -->
            <TextBlock Text="Indexed folders and drives" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ListView x:Name="IndexedRootsList" Style="{StaticResource ListBoxStyle}"
                              ItemsSource="{x:Bind ViewModel.Settings.IndexedRoots.Items}"
                              AutomationProperties.Name="Indexed folders and drives" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddIndexedRoot_Click" AccessKey="D" AutomationProperties.Name="Add folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add folder..." />
                            </StackPanel>
                        </Button>
                        <Button Click="RemoveIndexedRoot_Click" AutomationProperties.Name="Remove selected folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE738;" FontSize="12" />
                                <TextBlock Text="Remove" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Exclusions ============ -->
            <TextBlock Text="Exclusions" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="Folders and patterns that are never indexed, for example node_modules, .git or ?:/Windows." />
                    <ListView x:Name="FileExclusionsList" Style="{StaticResource ListBoxStyle}"
                              ItemsSource="{x:Bind ViewModel.Settings.FileExclusions.Items}"
                              AutomationProperties.Name="Exclusions" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="260" PlaceholderText="e.g. *.iso" FontFamily="{StaticResource IvyMono}"
                                 Text="{x:Bind ViewModel.Settings.FileExclusions.NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="FileExclusionBox_KeyDown"
                                 AutomationProperties.Name="New exclusion" />
                        <Button Content="Add" Click="AddFileExclusion_Click" />
                        <Button Content="Remove" Click="RemoveFileExclusion_Click" AutomationProperties.Name="Remove selected exclusion" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Media policy (PLAN decision 8) ============ -->
            <TextBlock Text="Originals uploaded automatically" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Upload images" />
                        <TextBlock Text="Sent in full so IVY can read their text." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.Settings.AutoUploadImages, Mode=TwoWay}"
                                  AutomationProperties.Name="Upload images" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Upload documents" />
                        <TextBlock Text="Sent in full for text search. Other files: metadata and thumbnail, original on request." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.Settings.AutoUploadDocuments, Mode=TwoWay}"
                                  AutomationProperties.Name="Upload documents" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRowStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Header="Image size cap (MB)" Width="160" FontFamily="{StaticResource IvyMono}"
                                 Text="{x:Bind ViewModel.Settings.ImageCapText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Document size cap (MB)" Width="180" FontFamily="{StaticResource IvyMono}"
                                 Text="{x:Bind ViewModel.Settings.DocumentCapText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Apply" VerticalAlignment="Bottom" AccessKey="K" Command="{x:Bind ViewModel.Settings.ApplyCapsCommand}"
                                AutomationProperties.Name="Apply size caps" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Settings.CapsStatus, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="File types counted as images and documents">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Image extensions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView x:Name="ImageExtensionsList" Style="{StaticResource ListBoxStyle}"
                                  ItemsSource="{x:Bind ViewModel.Settings.ImageExtensions.Items}"
                                  AutomationProperties.Name="Image extensions" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="120" PlaceholderText="e.g. tif" FontFamily="{StaticResource IvyMono}"
                                     Text="{x:Bind ViewModel.Settings.ImageExtensions.NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ImageExtensionBox_KeyDown"
                                     AutomationProperties.Name="New image extension" />
                            <Button Content="Add" Click="AddImageExtension_Click" AutomationProperties.Name="Add image extension" />
                            <Button Content="Remove" Click="RemoveImageExtension_Click" AutomationProperties.Name="Remove selected image extension" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Document extensions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView x:Name="DocumentExtensionsList" Style="{StaticResource ListBoxStyle}"
                                  ItemsSource="{x:Bind ViewModel.Settings.DocumentExtensions.Items}"
                                  AutomationProperties.Name="Document extensions" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="120" PlaceholderText="e.g. odt" FontFamily="{StaticResource IvyMono}"
                                     Text="{x:Bind ViewModel.Settings.DocumentExtensions.NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="DocumentExtensionBox_KeyDown"
                                     AutomationProperties.Name="New document extension" />
                            <Button Content="Add" Click="AddDocumentExtension_Click" AutomationProperties.Name="Add document extension" />
                            <Button Content="Remove" Click="RemoveDocumentExtension_Click" AutomationProperties.Name="Remove selected document extension" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
