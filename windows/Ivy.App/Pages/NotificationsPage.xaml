<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications collector: status card with its toggle and what the notification database state means. -->
<Page
    x:Class="Ivy.App.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ivy.App"
    xmlns:core="using:Ivy.App.Core"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Spacing="8">
            <Grid ColumnSpacing="16" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlyphTileStyle}" Width="48" Height="48">
                    <FontIcon Glyph="&#xEA8F;" FontSize="22" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Notifications" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.NotificationsRow.Description}" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                </StackPanel>
            </Grid>
            <InfoBar IsClosable="False"
                     IsOpen="{x:Bind ViewModel.NotificationsRow.HasProblem, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.NotificationsRow.HasProblem, Mode=OneWay}"
                     Severity="{x:Bind local:Ui.Severity(ViewModel.NotificationsRow.Severity), Mode=OneWay}"
                     Title="{x:Bind ViewModel.NotificationsRow.ProblemTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NotificationsRow.StatusReason, Mode=OneWay}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind local:Ui.Brush(ViewModel.NotificationsRow.StatusColor), Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NotificationsRow.StatusLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" AccessKey="N"
                                      IsOn="{x:Bind ViewModel.NotificationsRow.Enabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Notifications collector" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.NotificationsRow.StatusReason, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Last capture" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.NotificationsRow.LastCaptureText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Last upload" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.NotificationsRow.LastUploadText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="3" Text="Queue" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.NotificationsRow.QueueContributionText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="4" Text="Database" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.NotificationsRow.DetailText, Mode=OneWay}" Style="{StaticResource MonoValueStyle}" />
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Text="About the notification database" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Text="Windows keeps the notifications it shows in a database in your profile (wpndatabase.db). IVY reads a snapshot copy of it, so it never locks or changes the original." />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="Readable: the line above shows the last notification id read. If it is red, the snapshot copy failed; the reason is shown at the top of this page. Notifications are partial records (what the toast showed), not the conversations behind them." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
