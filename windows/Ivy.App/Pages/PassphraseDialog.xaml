<?xml version="1.0" encoding="utf-8"?>
<!-- The window-lock passphrase prompt: one box, Enter submits. Texts are set in code-behind. -->
<ContentDialog
    x:Class="Ivy.App.Pages.PassphraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    Closed="Dialog_Closed">

    <StackPanel Spacing="12" MinWidth="320">
        <PasswordBox x:Name="FirstBox" Header="Passphrase" KeyDown="FirstBox_KeyDown" />
    </StackPanel>
</ContentDialog>
