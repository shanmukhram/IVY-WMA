<?xml version="1.0" encoding="utf-8"?>
<!-- Overview: problems first (InfoBars), then the status card, collector tiles and the live activity feed. -->
<Page
    x:Class="Ivy.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ivy.App"
    xmlns:core="using:Ivy.App.Core"
    xmlns:vm="using:Ivy.App.Core.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Spacing="8">
            <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="What this PC captures and sends to IVY." Style="{StaticResource PageSubtitleStyle}" />

            <!-- ============ Problems ============ -->
            <InfoBar IsClosable="False"
                     IsOpen="{x:Bind ViewModel.Overview.HasBucketProblem, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Overview.HasBucketProblem, Mode=OneWay}"
                     Severity="{x:Bind local:Ui.Severity(ViewModel.Overview.BucketSeverity), Mode=OneWay}"
                     Title="{x:Bind ViewModel.Overview.BucketProblemTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Overview.BucketProblemMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry now" Command="{x:Bind ViewModel.SyncNowCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsClosable="False" Severity="Warning" Title="Collectors need attention"
                     IsOpen="{x:Bind ViewModel.Overview.HasCollectorProblems, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Overview.HasCollectorProblems, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Overview.CollectorProblemsText, Mode=OneWay}" />
            <InfoBar IsClosable="False" Severity="Error" Title="Collector host"
                     IsOpen="{x:Bind local:Ui.HasText(ViewModel.HostErrorText), Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.HostErrorText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.HostErrorText, Mode=OneWay}" />
            <InfoBar IsClosable="False" Severity="Error" Title="Settings"
                     IsOpen="{x:Bind local:Ui.HasText(ViewModel.Settings.SettingsError), Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Settings.SettingsError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.Settings.SettingsError, Mode=OneWay}" />

            <!-- ============ Status card ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GlyphTileStyle}" Width="48" Height="48">
                            <FontIcon Glyph="&#xE7F4;" FontSize="22" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="This PC" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Overview.RunStateLine, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0" AccessKey="R"
                                      IsOn="{x:Bind ViewModel.IsRunning, Mode=TwoWay}"
                                      OnContent="Running" OffContent="Paused"
                                      AutomationProperties.Name="Capture and upload" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Paired to IVY" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Overview.MacFingerprint, Mode=OneWay}" Style="{StaticResource MonoValueStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="This device" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.Overview.DeviceFingerprint, Mode=OneWay}" Style="{StaticResource MonoValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last upload" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Overview.LastUploadText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Last command poll" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.Overview.LastPollText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bucket" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{x:Bind local:Ui.Brush(ViewModel.Overview.BucketColor), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Overview.BucketStateText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Queued" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldValueStyle}"><Run Text="{x:Bind ViewModel.PendingObjectsText, Mode=OneWay}" /><Run Text=" objects, " /><Run Text="{x:Bind ViewModel.PendingBytesText, Mode=OneWay}" /></TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ Collector tiles (each opens its page) ============ -->
            <TextBlock Text="Collectors" Style="{StaticResource SectionHeaderStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Collectors}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="220" MinItemHeight="72" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectorRowViewModel">
                        <Button Tag="{x:Bind Name}" Click="Tile_Click"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Padding="14,10"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                AutomationProperties.HelpText="{x:Bind StatusLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind StatusReason, Mode=OneWay}">
                            <Grid ColumnSpacing="12" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Grid.RowSpan="2" Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind local:Ui.Brush(StatusColor), Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind StatusLabel, Mode=OneWay}" /><Run Text="  ·  last capture " /><Run Text="{x:Bind LastCaptureText, Mode=OneWay}" /></TextBlock>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ============ Live activity ============ -->
            <Grid Margin="1,24,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Activity" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Feed.HeldText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="2" Click="PauseScroll_Click"
                              IsChecked="{x:Bind ViewModel.Feed.ScrollPaused, Mode=OneWay}"
                              AutomationProperties.Name="Pause scroll">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="12" />
                        <TextBlock Text="Pause scroll" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
            <Border Style="{StaticResource CardStyle}" Padding="4">
                <ListView ItemsSource="{x:Bind ViewModel.Feed.Items}" SelectionMode="None" Height="320"
                          AutomationProperties.Name="Live activity, newest first">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="12,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:FeedEntry">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" FontFamily="{StaticResource IvyMono}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CollectorText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Event}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind DetailText}" FontFamily="{StaticResource IvyMono}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
