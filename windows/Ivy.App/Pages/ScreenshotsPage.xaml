<?xml version="1.0" encoding="utf-8"?>
<!-- Screenshots collector: status card with its toggle and the screenshot folders. -->
<Page
    x:Class="Ivy.App.Pages.ScreenshotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ivy.App"
    xmlns:core="using:Ivy.App.Core"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Spacing="8">
            <Grid ColumnSpacing="16" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlyphTileStyle}" Width="48" Height="48">
                    <FontIcon Glyph="&#xE722;" FontSize="22" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Screenshots" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ScreenshotsRow.Description}" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                </StackPanel>
            </Grid>
            <InfoBar IsClosable="False"
                     IsOpen="{x:Bind ViewModel.ScreenshotsRow.HasProblem, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.ScreenshotsRow.HasProblem, Mode=OneWay}"
                     Severity="{x:Bind local:Ui.Severity(ViewModel.ScreenshotsRow.Severity), Mode=OneWay}"
                     Title="{x:Bind ViewModel.ScreenshotsRow.ProblemTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ScreenshotsRow.StatusReason, Mode=OneWay}" />
            <InfoBar IsClosable="False" Severity="Error" Title="Settings"
                     IsOpen="{x:Bind local:Ui.HasText(ViewModel.Settings.SettingsError), Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Settings.SettingsError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.Settings.SettingsError, Mode=OneWay}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind local:Ui.Brush(ViewModel.ScreenshotsRow.StatusColor), Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScreenshotsRow.StatusLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" AccessKey="N"
                                      IsOn="{x:Bind ViewModel.ScreenshotsRow.Enabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Screenshots collector" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ScreenshotsRow.StatusReason, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Last capture" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ScreenshotsRow.LastCaptureText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Last upload" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ScreenshotsRow.LastUploadText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Grid.Row="3" Text="Queue" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.ScreenshotsRow.QueueContributionText, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" />
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Text="Screenshot folders" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="New images in these folders upload in full; IVY reads their text. The Windows Screenshots folder is watched by default." />
                    <ListView x:Name="ScreenshotRootsList" Style="{StaticResource ListBoxStyle}"
                              ItemsSource="{x:Bind ViewModel.Settings.ScreenshotRoots.Items}"
                              AutomationProperties.Name="Screenshot folders" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddScreenshotRoot_Click" AccessKey="D" AutomationProperties.Name="Add folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add folder..." />
                            </StackPanel>
                        </Button>
                        <Button Click="RemoveScreenshotRoot_Click" AutomationProperties.Name="Remove selected folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE738;" FontSize="12" />
                                <TextBlock Text="Remove" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
