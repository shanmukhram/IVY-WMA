<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown in the content area while the window privacy lock is closed (PLAN decision 17). The WebView2 that shows the
  configured dashboard is created in code-behind and inserted into RootGrid under the placeholder, because a closed
  WebView2 cannot be reused and a fresh one is built each time the page is navigated to. The placeholder (an empty
  Grid, no text, no icon, no background so Mica shows through) is visible until the first successful load and
  whenever the web content is not available.
-->
<Page
    x:Class="Ivy.App.Pages.CoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid x:Name="RootGrid">
        <Grid x:Name="Placeholder" Visibility="Visible" />
    </Grid>
</Page>
