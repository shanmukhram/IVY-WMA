<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ivy.App.Core.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ivy.App.Core\Ivy.App.Core.csproj" />
    <!-- The WinUI shell's CollectorHost adapter is plain C#; link it here so it runs against the real host (net8.0 target). -->
    <ProjectReference Include="..\Ivy.Collectors\Ivy.Collectors.csproj" />
    <Compile Include="..\Ivy.App\Hosting\CollectorHostAdapter.cs" Link="Linked\CollectorHostAdapter.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
