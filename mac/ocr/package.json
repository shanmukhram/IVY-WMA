{
  "name": "@ivy/mac-ocr",
  "version": "0.1.0",
  "private": true,
  "description": "Local OCR (Apple Vision) and thumbnail helper for the IVY Mac dashboard. Spawns a warm Swift helper and multiplexes requests over NDJSON. No database dependency.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "swift/Package.swift",
    "swift/Sources"
  ],
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:swift": "swift build -c release --package-path swift",
    "ocr": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
