{
  "name": "@ivy/mac-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IVY Mac dashboard web UI (served by @ivy/mac-service at /; wrapped by @ivy/mac-app).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @ivy/protocol --filter @ivy/mac-ocr build && vite build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.32.0"
  },
  "devDependencies": {
    "@ivy/mac-service": "workspace:*",
    "@ivy/protocol": "workspace:*",
    "@ivy/s3-mock": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
